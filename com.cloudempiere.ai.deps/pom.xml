<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudempiere.ai</groupId>
        <artifactId>com.cloudempiere.ai.parent</artifactId>
        <version>14.0.0-SNAPSHOT</version>
        <relativePath>../com.cloudempiere.ai.parent/pom.xml</relativePath>
    </parent>

    <artifactId>com.cloudempiere.ai.deps</artifactId>
    <packaging>eclipse-plugin</packaging>
    <name>Cloudempiere AI - Shared Dependencies</name>

    <properties>
        <clde.bundle.kind>wrapper</clde.bundle.kind>
    </properties>

    <build>
        <plugins>
            <!-- Ensure target/classes exists so tycho-ds-plugin doesn't fail when there are no Java sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>create-output-directory</id>
                        <phase>generate-sources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.outputDirectory}"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Copy dependencies to lib/ directory -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-langchain4j</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- LangChain4j Core -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-core</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-core-1.20.0.jar</destFileName>
                                </artifactItem>

                                <!-- LangChain4j HTTP client abstraction (new in 1.x - langchain4j itself is no
                                     longer OkHttp/Retrofit/Kotlin based; this is its JDK HttpClient-backed
                                     default transport) -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-http-client</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-http-client-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-http-client-jdk</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-http-client-jdk-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-reactive-streaming</artifactId>
                                    <version>1.20.0-beta30</version>
                                    <destFileName>langchain4j-reactive-streaming-1.20.0-beta30.jar</destFileName>
                                </artifactItem>

                                <!-- LangChain4j Providers -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-anthropic</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-anthropic-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-ollama</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-ollama-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-open-ai</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-open-ai-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-bedrock</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-bedrock-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <!-- Only ever published as beta at every version, including the 1.20.0 line -->
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-pgvector</artifactId>
                                    <version>1.20.0-beta30</version>
                                    <destFileName>langchain4j-pgvector-1.20.0-beta30.jar</destFileName>
                                </artifactItem>

                                <!-- LangChain4j MCP Client (NEW - ADR-049). Only ever published as beta;
                                     no stable release of this artifact has ever existed. -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-mcp</artifactId>
                                    <version>1.20.0-beta30</version>
                                    <destFileName>langchain4j-mcp-1.20.0-beta30.jar</destFileName>
                                </artifactItem>

                                <!-- LangChain4j Core's new (1.x) mandatory transitive dependencies -->
                                <artifactItem>
                                    <groupId>org.apache.opennlp</groupId>
                                    <artifactId>opennlp-tools</artifactId>
                                    <version>2.5.11</version>
                                    <destFileName>opennlp-tools-2.5.11.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.smallrye.reactive</groupId>
                                    <artifactId>mutiny-zero</artifactId>
                                    <version>1.3.1</version>
                                    <destFileName>mutiny-zero-1.3.1.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.jspecify</groupId>
                                    <artifactId>jspecify</artifactId>
                                    <version>1.0.1</version>
                                    <destFileName>jspecify-1.0.1.jar</destFileName>
                                </artifactItem>

                                <!-- Jackson (used by langchain4j-core) -->
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                    <version>2.22.1</version>
                                    <destFileName>jackson-core-2.22.1.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                    <version>2.22.1</version>
                                    <destFileName>jackson-databind-2.22.1.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-annotations</artifactId>
                                    <version>2.22</version>
                                    <destFileName>jackson-annotations-2.22.jar</destFileName>
                                </artifactItem>

                                <!-- Other Dependencies -->
                                <artifactItem>
                                    <groupId>com.knuddels</groupId>
                                    <artifactId>jtokkit</artifactId>
                                    <version>1.1.0</version>
                                    <destFileName>jtokkit-1.1.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark</artifactId>
                                    <version>0.30.0</version>
                                    <destFileName>commonmark-0.30.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark-ext-gfm-tables</artifactId>
                                    <version>0.30.0</version>
                                    <destFileName>commonmark-ext-gfm-tables-0.30.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
                                    <version>0.30.0</version>
                                    <destFileName>commonmark-ext-gfm-strikethrough-0.30.0.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>lib</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
