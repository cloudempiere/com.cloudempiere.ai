<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudempiere.ai</groupId>
        <artifactId>com.cloudempiere.ai.parent</artifactId>
        <version>10.0.2-SNAPSHOT</version>
        <relativePath>../com.cloudempiere.ai.parent/pom.xml</relativePath>
    </parent>

    <artifactId>com.cloudempiere.ai.deps</artifactId>
    <version>0.35.0-SNAPSHOT</version>
    <packaging>eclipse-plugin</packaging>
    <name>CloudEmpiere AI - Shared Dependencies</name>

    <build>
        <plugins>
            <!-- Copy dependencies to lib/ directory -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-langchain4j</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- LangChain4j Core -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-0.35.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-core</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-core-0.35.0.jar</destFileName>
                                </artifactItem>

                                <!-- LangChain4j Providers -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-anthropic</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-anthropic-0.35.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-ollama</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-ollama-0.35.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-open-ai</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-open-ai-0.35.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-bedrock</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-bedrock-0.35.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-pgvector</artifactId>
                                    <version>0.35.0</version>
                                    <destFileName>langchain4j-pgvector-0.35.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>dev.ai4j</groupId>
                                    <artifactId>openai4j</artifactId>
                                    <version>0.22.0</version>
                                    <destFileName>openai4j-0.22.0.jar</destFileName>
                                </artifactItem>

                                <!-- Anthropic SDK -->
                                <artifactItem>
                                    <groupId>com.anthropic</groupId>
                                    <artifactId>anthropic-java-core</artifactId>
                                    <version>2.10.0</version>
                                    <destFileName>anthropic-java-core-2.10.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.anthropic</groupId>
                                    <artifactId>anthropic-java-client-okhttp</artifactId>
                                    <version>2.10.0</version>
                                    <destFileName>anthropic-java-client-okhttp-2.10.0.jar</destFileName>
                                </artifactItem>

                                <!-- AWS SDK - Bedrock services only (core provided by com.cloudempiere.aws.provider) -->
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>bedrockruntime</artifactId>
                                    <version>2.20.162</version>
                                    <destFileName>bedrockruntime-2.20.162.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>bedrock</artifactId>
                                    <version>2.20.162</version>
                                    <destFileName>bedrock-2.20.162.jar</destFileName>
                                </artifactItem>

                                <!-- Jackson -->
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-core</artifactId>
                                    <version>2.17.0</version>
                                    <destFileName>jackson-core-2.17.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-databind</artifactId>
                                    <version>2.17.0</version>
                                    <destFileName>jackson-databind-2.17.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.core</groupId>
                                    <artifactId>jackson-annotations</artifactId>
                                    <version>2.17.0</version>
                                    <destFileName>jackson-annotations-2.17.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.module</groupId>
                                    <artifactId>jackson-module-kotlin</artifactId>
                                    <version>2.17.0</version>
                                    <destFileName>jackson-module-kotlin-2.17.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.datatype</groupId>
                                    <artifactId>jackson-datatype-jdk8</artifactId>
                                    <version>2.17.0</version>
                                    <destFileName>jackson-datatype-jdk8-2.17.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.fasterxml.jackson.datatype</groupId>
                                    <artifactId>jackson-datatype-jsr310</artifactId>
                                    <version>2.17.0</version>
                                    <destFileName>jackson-datatype-jsr310-2.17.0.jar</destFileName>
                                </artifactItem>

                                <!-- Kotlin -->
                                <artifactItem>
                                    <groupId>org.jetbrains.kotlin</groupId>
                                    <artifactId>kotlin-stdlib</artifactId>
                                    <version>1.9.10</version>
                                    <destFileName>kotlin-stdlib-1.9.10.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.jetbrains.kotlin</groupId>
                                    <artifactId>kotlin-reflect</artifactId>
                                    <version>1.9.10</version>
                                    <destFileName>kotlin-reflect-1.9.10.jar</destFileName>
                                </artifactItem>

                                <!-- OkHttp -->
                                <artifactItem>
                                    <groupId>com.squareup.okhttp3</groupId>
                                    <artifactId>okhttp</artifactId>
                                    <version>4.12.0</version>
                                    <destFileName>okhttp-4.12.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.squareup.okhttp3</groupId>
                                    <artifactId>okhttp-sse</artifactId>
                                    <version>4.12.0</version>
                                    <destFileName>okhttp-sse-4.12.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.squareup.okio</groupId>
                                    <artifactId>okio</artifactId>
                                    <version>3.6.0</version>
                                    <destFileName>okio-3.6.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.squareup.okio</groupId>
                                    <artifactId>okio-jvm</artifactId>
                                    <version>3.6.0</version>
                                    <destFileName>okio-jvm-3.6.0.jar</destFileName>
                                </artifactItem>

                                <!-- Netty -->
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-codec-http-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http2</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-codec-http2-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-codec-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-transport-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-common</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-common-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-buffer</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-buffer-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-handler</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-handler-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-resolver</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-resolver-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-native-unix-common</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-transport-native-unix-common-4.1.100.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-classes-epoll</artifactId>
                                    <version>4.1.100.Final</version>
                                    <destFileName>netty-transport-classes-epoll-4.1.100.Final.jar</destFileName>
                                </artifactItem>

                                <!-- Other Dependencies -->
                                <artifactItem>
                                    <groupId>org.reactivestreams</groupId>
                                    <artifactId>reactive-streams</artifactId>
                                    <version>1.0.4</version>
                                    <destFileName>reactive-streams-1.0.4.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.squareup.retrofit2</groupId>
                                    <artifactId>retrofit</artifactId>
                                    <version>2.9.0</version>
                                    <destFileName>retrofit-2.9.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.squareup.retrofit2</groupId>
                                    <artifactId>converter-jackson</artifactId>
                                    <version>2.9.0</version>
                                    <destFileName>converter-jackson-2.9.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.squareup.retrofit2</groupId>
                                    <artifactId>converter-gson</artifactId>
                                    <version>2.9.0</version>
                                    <destFileName>converter-gson-2.9.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.google.code.gson</groupId>
                                    <artifactId>gson</artifactId>
                                    <version>2.10.1</version>
                                    <destFileName>gson-2.10.1.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>com.knuddels</groupId>
                                    <artifactId>jtokkit</artifactId>
                                    <version>1.0.0</version>
                                    <destFileName>jtokkit-1.0.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark</artifactId>
                                    <version>0.22.0</version>
                                    <destFileName>commonmark-0.22.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark-ext-gfm-tables</artifactId>
                                    <version>0.22.0</version>
                                    <destFileName>commonmark-ext-gfm-tables-0.22.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.commonmark</groupId>
                                    <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
                                    <version>0.22.0</version>
                                    <destFileName>commonmark-ext-gfm-strikethrough-0.22.0.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>lib</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
