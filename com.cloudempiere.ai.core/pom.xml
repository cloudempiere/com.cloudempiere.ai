<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudempiere.ai</groupId>
        <artifactId>com.cloudempiere.ai.parent</artifactId>
        <version>14.0.0-SNAPSHOT</version>
        <relativePath>../com.cloudempiere.ai.parent/pom.xml</relativePath>
    </parent>

    <artifactId>com.cloudempiere.ai.core</artifactId>
    <packaging>eclipse-plugin</packaging>
    <name>Cloudempiere AI - Core Infrastructure</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- AWS SDK - Bedrock services (depend on aws-core from aws.provider).
                                     Version pinned to MATCH com.cloudempiere.aws.provider's AWS SDK version
                                     (2.31.11) rather than whatever langchain4j-bedrock:1.20.0's own BOM
                                     declares (2.41.34) - AWS's own versioning policy warns against mixing
                                     AWS SDK module versions within one runtime, and ai.core shares its
                                     "core" AWS classes (regions/auth/http-client-spi/etc.) with aws.provider
                                     via Require-Bundle, so a self-consistent version across ai.core +
                                     aws.provider matters more here than matching langchain4j-bedrock's BOM.
                                     Safe to diverge from langchain4j-bedrock's own pin because we inject our
                                     own BedrockRuntimeClient/BedrockRuntimeAsyncClient (see BedrockClients.java)
                                     rather than letting it build one internally - exactly the use case
                                     langchain4j PRs #2285/#2914 added client injection for. -->
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>bedrockruntime</artifactId>
                                    <version>2.31.11</version>
                                    <destFileName>bedrockruntime-2.31.11.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>bedrock</artifactId>
                                    <version>2.31.11</version>
                                    <destFileName>bedrock-2.31.11.jar</destFileName>
                                </artifactItem>
                                <!-- AWS SDK - Netty async HTTP client + Netty core dependencies -->
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>netty-nio-client</artifactId>
                                    <version>2.31.11</version>
                                    <destFileName>netty-nio-client-2.31.11.jar</destFileName>
                                </artifactItem>
                                <!-- Netty (version matches what AWS SDK 2.31.11's netty-nio-client compiles against) -->
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-codec-http-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http2</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-codec-http2-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-codec-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-transport-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-common</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-common-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-buffer</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-buffer-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-handler</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-handler-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-resolver</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-resolver-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-native-unix-common</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-transport-native-unix-common-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport-classes-epoll</artifactId>
                                    <version>4.1.118.Final</version>
                                    <destFileName>netty-transport-classes-epoll-4.1.118.Final.jar</destFileName>
                                </artifactItem>
                                <!-- Reactive Streams (dependency of AWS SDK) -->
                                <artifactItem>
                                    <groupId>org.reactivestreams</groupId>
                                    <artifactId>reactive-streams</artifactId>
                                    <version>1.0.4</version>
                                    <destFileName>reactive-streams-1.0.4.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>lib</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
