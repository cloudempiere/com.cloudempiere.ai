<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.cloudempiere.ai</groupId>
        <artifactId>com.cloudempiere.ai.parent</artifactId>
        <version>14.0.0-SNAPSHOT</version>
        <relativePath>../com.cloudempiere.ai.parent/pom.xml</relativePath>
    </parent>

    <artifactId>com.cloudempiere.ai.core</artifactId>
    <packaging>eclipse-plugin</packaging>
    <name>Cloudempiere AI - Core Infrastructure</name>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-dependencies</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <!-- CLD-2431: LangChain4j's Bedrock module and the complete AWS SDK it was built against, private to
                                     this bundle. langchain4j-bedrock 1.20.0 needs AWS SDK 2.41.34 (its model classes use
                                     bedrockruntime types such as CachePointBlock), while com.cloudempiere.aws.provider ships 2.31.11 to
                                     the rest of the platform; AWS SDK modules must not be mixed across versions, so ai.core embeds a
                                     self-consistent 2.41.34 set (resolved from the AWS SDK BOM 2.41.34 for bedrockruntime, bedrock,
                                     netty-nio-client and apache-client) and no longer requires aws.provider. Nothing here is exported.
                                     Keep the SDK version equal to the one langchain4j-bedrock declares when upgrading LangChain4j. -->
                                <artifactItem>
                                    <groupId>dev.langchain4j</groupId>
                                    <artifactId>langchain4j-bedrock</artifactId>
                                    <version>1.20.0</version>
                                    <destFileName>langchain4j-bedrock-1.20.0.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>bedrockruntime</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>bedrockruntime-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>bedrock</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>bedrock-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>netty-nio-client</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>netty-nio-client-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>apache-client</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>apache-client-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>annotations</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>annotations-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>auth</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>auth-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>aws-core</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>aws-core-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>aws-json-protocol</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>aws-json-protocol-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>checksums</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>checksums-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>checksums-spi</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>checksums-spi-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>endpoints-spi</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>endpoints-spi-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>http-auth</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>http-auth-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>http-auth-aws</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>http-auth-aws-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>http-auth-aws-eventstream</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>http-auth-aws-eventstream-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
