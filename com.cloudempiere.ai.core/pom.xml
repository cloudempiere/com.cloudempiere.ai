                                    <artifactId>http-auth-spi</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>http-auth-spi-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
