                                    <destFileName>identity-spi-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>json-utils</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>json-utils-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>metrics-spi</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>metrics-spi-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>profiles</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>profiles-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>protocol-core</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>protocol-core-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>regions</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>regions-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>retries</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>retries-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>retries-spi</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>retries-spi-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>software.amazon.awssdk</groupId>
                                    <artifactId>sdk-core</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>sdk-core-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
