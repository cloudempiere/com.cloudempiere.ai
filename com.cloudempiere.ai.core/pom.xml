                                    <artifactId>utils-lite</artifactId>
                                    <version>2.41.34</version>
                                    <destFileName>utils-lite-2.41.34.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-buffer</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-buffer-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-codec-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-codec-http-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-codec-http2</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-codec-http2-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-common</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-common-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-handler</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-handler-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-resolver</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-resolver-4.1.130.Final.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>io.netty</groupId>
                                    <artifactId>netty-transport</artifactId>
                                    <version>4.1.130.Final</version>
                                    <destFileName>netty-transport-4.1.130.Final.jar</destFileName>
