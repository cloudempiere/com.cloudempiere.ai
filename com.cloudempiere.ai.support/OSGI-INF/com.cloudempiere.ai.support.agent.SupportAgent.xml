<?xml version="1.0" encoding="UTF-8"?>
<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.3.0"
               name="com.cloudempiere.ai.support.agent.SupportAgent"
               activate="activate"
               immediate="true">
   <implementation class="com.cloudempiere.ai.support.agent.SupportAgent"/>
   <service>
      <provide interface="com.cloudempiere.ai.support.agent.SupportAgent"/>
      <provide interface="com.cloudempiere.ai.boundary.IDomainAgent"/>
   </service>
   <reference bind="setProviderFactory"
              cardinality="1..1"
              field="providerFactory"
              interface="com.cloudempiere.ai.provider.langchain4j.ILangChain4jProviderFactory"
              name="ILangChain4jProviderFactory"
              policy="static"/>
   <reference bind="setSupportTools"
              cardinality="1..1"
              field="supportTools"
              interface="com.cloudempiere.ai.support.tools.SupportTools"
              name="SupportTools"
              policy="static"/>
</scr:component>
