Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: Cloudempiere AI - MCP Server
Bundle-SymbolicName: com.cloudempiere.ai.mcp;singleton:=true
Bundle-Version: 14.0.0.qualifier
Bundle-Vendor: Cloudempiere
Bundle-RequiredExecutionEnvironment: JavaSE-17
Bundle-ActivationPolicy: lazy
Automatic-Module-Name: com.cloudempiere.ai.mcp
Require-Bundle: org.adempiere.base;bundle-version="[14.0.0,15.0.0)",
 org.adempiere.plugin.utils;bundle-version="[14.0.0,15.0.0)",
 com.cloudempiere.ai.core;bundle-version="[14.0.0,15.0.0)",
 com.cloudempiere.ai.deps;bundle-version="[14.0.0,15.0.0)"
Import-Package: com.cloudempiere.core.base.auth,
 javax.servlet;version="3.1.0",
 javax.servlet.http;version="3.1.0",
 org.json,
 org.osgi.framework,
 org.osgi.util.tracker
Export-Package: com.cloudempiere.ai.mcp;version="14.0.0"
Web-ContextPath: ai-mcp
Jetty-Environment: ee8
