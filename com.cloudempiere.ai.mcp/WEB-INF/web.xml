<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0"
         metadata-complete="true">
    <display-name>Cloudempiere AI MCP Server</display-name>

    <!-- metadata-complete: no annotation scan over the bundle classpath (slow startup, see com.cloudempiere.graphql) -->

    <servlet>
        <servlet-name>McpServlet</servlet-name>
        <servlet-class>com.cloudempiere.ai.mcp.McpServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <!-- "/*", not "/": the endpoint is the context root (/ai-mcp); see WEB-INF/jetty-web.xml -->
    <servlet-mapping>
        <servlet-name>McpServlet</servlet-name>
        <url-pattern>/*</url-pattern>
    </servlet-mapping>
</web-app>
