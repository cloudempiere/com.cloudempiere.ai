<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>com.cloudempiere.ai</artifactId>
  <version>10.0.0-SNAPSHOT</version>
  <packaging>eclipse-plugin</packaging>
  <parent>
	<groupId>org.idempiere</groupId>
	<artifactId>org.idempiere.parent</artifactId>
	<version>${revision}</version>
	<relativePath>../iDempiereCLDE/org.idempiere.parent/pom.xml</relativePath>
  </parent>

  <properties>
    <junit.version>5.10.2</junit.version>
    <mockito.version>5.11.0</mockito.version>
  </properties>

  <dependencies>
    <!-- Test Dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.25.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
		<testSourceDirectory>src/test/java</testSourceDirectory>
		<plugins>
			<!-- Tycho Compiler Plugin - exclude test directory from OSGi compilation -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-compiler-plugin</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<testExcludes>
						<testExclude>**/test/**/*.java</testExclude>
					</testExcludes>
				</configuration>
			</plugin>
		    <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>validate</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.anthropic</groupId>
								    <artifactId>anthropic-java-core</artifactId>
								    <version>2.10.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.anthropic</groupId>
								    <artifactId>anthropic-java-client-okhttp</artifactId>
								    <version>2.10.0</version>
								</artifactItem>
								<artifactItem>
							    	<groupId>com.fasterxml.jackson.module</groupId>
							    	<artifactId>jackson-module-kotlin</artifactId>
							    	<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.fasterxml.jackson.datatype</groupId>
								    <artifactId>jackson-datatype-jdk8</artifactId>
								    <version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jetbrains.kotlin</groupId>
									<artifactId>kotlin-stdlib</artifactId>
									<version>1.9.10</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jetbrains.kotlin</groupId>
									<artifactId>kotlin-reflect</artifactId>
									<version>1.9.10</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.fasterxml.jackson.datatype</groupId>
								    <artifactId>jackson-datatype-jsr310</artifactId>
								    <version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.fasterxml.jackson.core</groupId>
									<artifactId>jackson-core</artifactId>
									<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.fasterxml.jackson.core</groupId>
									<artifactId>jackson-databind</artifactId>
									<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.fasterxml.jackson.core</groupId>
									<artifactId>jackson-annotations</artifactId>
									<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.squareup.okhttp3</groupId>
									<artifactId>okhttp</artifactId>
									<version>4.12.0</version>
								</artifactItem>
								<!-- OkHttp SSE for streaming responses (EventSourceListener) -->
								<artifactItem>
									<groupId>com.squareup.okhttp3</groupId>
									<artifactId>okhttp-sse</artifactId>
									<version>4.12.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.squareup.okio</groupId>
									<artifactId>okio</artifactId>
									<version>3.6.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.squareup.okio</groupId>
									<artifactId>okio-jvm</artifactId>
									<version>3.6.0</version>
								</artifactItem>
								<!-- https://mvnrepository.com/artifact/dev.langchain4j/langchain4j -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j Core for @Tool annotations -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-core</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j Anthropic Provider -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-anthropic</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j Ollama Provider (local LLM) -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-ollama</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j OpenAI Provider -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-open-ai</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- OpenAI4j Client - required by langchain4j-open-ai 0.35.0 -->
								<artifactItem>
								    <groupId>dev.ai4j</groupId>
								    <artifactId>openai4j</artifactId>
								    <version>0.22.0</version>
								</artifactItem>
								<!-- LangChain4j AWS Bedrock Provider -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-bedrock</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- AWS SDK v2 Bedrock Runtime - required by langchain4j-bedrock 0.35.0 -->
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>bedrockruntime</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>bedrock</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<!-- AWS SDK v2 Core dependencies -->
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>sdk-core</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>auth</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>regions</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>utils</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>http-client-spi</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>aws-core</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>protocol-core</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>json-utils</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>profiles</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>metrics-spi</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>endpoints-spi</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>aws-json-protocol</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>apache-client</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>netty-nio-client</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<artifactItem>
								    <groupId>software.amazon.awssdk</groupId>
								    <artifactId>annotations</artifactId>
								    <version>2.20.162</version>
								</artifactItem>
								<!-- AWS SDK third-party dependencies -->
								<artifactItem>
								    <groupId>org.apache.httpcomponents</groupId>
								    <artifactId>httpclient</artifactId>
								    <version>4.5.14</version>
								</artifactItem>
								<artifactItem>
								    <groupId>org.apache.httpcomponents</groupId>
								    <artifactId>httpcore</artifactId>
								    <version>4.4.16</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-codec-http</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-codec-http2</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-codec</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-transport</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-common</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-buffer</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-handler</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-resolver</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-transport-native-unix-common</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>io.netty</groupId>
								    <artifactId>netty-transport-classes-epoll</artifactId>
								    <version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
								    <groupId>org.reactivestreams</groupId>
								    <artifactId>reactive-streams</artifactId>
								    <version>1.0.4</version>
								</artifactItem>
								<!-- Retrofit2 - required by LangChain4j Anthropic -->
								<artifactItem>
								    <groupId>com.squareup.retrofit2</groupId>
								    <artifactId>retrofit</artifactId>
								    <version>2.9.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.squareup.retrofit2</groupId>
								    <artifactId>converter-jackson</artifactId>
								    <version>2.9.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.squareup.retrofit2</groupId>
								    <artifactId>converter-gson</artifactId>
								    <version>2.9.0</version>
								</artifactItem>
								<!-- Gson - required by Retrofit converter-gson -->
								<artifactItem>
								    <groupId>com.google.code.gson</groupId>
								    <artifactId>gson</artifactId>
								    <version>2.10.1</version>
								</artifactItem>
								<!-- LangChain4j PgVector for persistent embedding storage (P1 Context Layer) -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-pgvector</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- PostgreSQL JDBC Driver - provided by org.compiere.db.postgresql.provider bundle -->
								<!-- Not bundled here to avoid duplication; accessed via Require-Bundle in MANIFEST.MF -->
								<!-- OpenAI4j - required by langchain4j-open-ai (used for AI Hub provider) -->
								<artifactItem>
								    <groupId>dev.ai4j</groupId>
								    <artifactId>openai4j</artifactId>
								    <version>0.22.0</version>
								</artifactItem>
								<!-- SLF4J API - required by LangChain4j and OpenAI4j -->
								<artifactItem>
								    <groupId>org.slf4j</groupId>
								    <artifactId>slf4j-api</artifactId>
								    <version>2.0.9</version>
								</artifactItem>
								<!-- SLF4J NOP (no-operation) - prevent "no binding" warnings in tests -->
								<artifactItem>
								    <groupId>org.slf4j</groupId>
								    <artifactId>slf4j-nop</artifactId>
								    <version>2.0.9</version>
								</artifactItem>
								<!-- JTokkit - tokenizer library required by langchain4j-open-ai -->
								<artifactItem>
								    <groupId>com.knuddels</groupId>
								    <artifactId>jtokkit</artifactId>
								    <version>1.0.0</version>
								</artifactItem>
								<!-- CommonMark Java for full markdown parsing (ADR-047) -->
								<artifactItem>
								    <groupId>org.commonmark</groupId>
								    <artifactId>commonmark</artifactId>
								    <version>0.22.0</version>
								</artifactItem>
								<!-- CommonMark extensions for tables, strikethrough, etc. -->
								<artifactItem>
								    <groupId>org.commonmark</groupId>
								    <artifactId>commonmark-ext-gfm-tables</artifactId>
								    <version>0.22.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>org.commonmark</groupId>
								    <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
								    <version>0.22.0</version>
								</artifactItem>
							</artifactItems>
							<outputDirectory>lib</outputDirectory>
							<stripVersion>true</stripVersion>
							<overWriteReleases>true</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
		    <!-- Maven Compiler Plugin for test sources -->
		    <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<id>compile-tests</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<source>11</source>
							<target>11</target>
							<testSource>11</testSource>
							<testTarget>11</testTarget>
						</configuration>
					</execution>
				</executions>
			</plugin>
		    <!-- Maven Surefire Plugin for JUnit 5 -->
		    <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
					</includes>
					<excludes>
						<exclude>**/TestAIProvider.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>