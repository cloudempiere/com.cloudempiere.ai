<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <artifactId>com.cloudempiere.ai</artifactId>
  <version>10.0.0-SNAPSHOT</version>
  <packaging>eclipse-plugin</packaging>
  <parent>
	<groupId>org.idempiere</groupId>
	<artifactId>org.idempiere.parent</artifactId>
	<version>${revision}</version>
	<relativePath>../iDempiereCLDE/org.idempiere.parent/pom.xml</relativePath>
  </parent>

  <properties>
    <junit.version>5.10.2</junit.version>
    <mockito.version>5.11.0</mockito.version>
  </properties>

  <dependencies>
    <!-- Test Dependencies -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <version>${mockito.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <version>3.25.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
		<testSourceDirectory>src/test/java</testSourceDirectory>
		<plugins>
		    <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-dependency-plugin</artifactId>
				<executions>
					<execution>
						<id>copy-dependencies</id>
						<phase>validate</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.anthropic</groupId>
								    <artifactId>anthropic-java-core</artifactId>
								    <version>2.10.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.anthropic</groupId>
								    <artifactId>anthropic-java-client-okhttp</artifactId>
								    <version>2.10.0</version>
								</artifactItem>
								<artifactItem>
							    	<groupId>com.fasterxml.jackson.module</groupId>
							    	<artifactId>jackson-module-kotlin</artifactId>
							    	<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.fasterxml.jackson.datatype</groupId>
								    <artifactId>jackson-datatype-jdk8</artifactId>
								    <version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jetbrains.kotlin</groupId>
									<artifactId>kotlin-stdlib</artifactId>
									<version>1.9.10</version>
								</artifactItem>
								<artifactItem>
									<groupId>org.jetbrains.kotlin</groupId>
									<artifactId>kotlin-reflect</artifactId>
									<version>1.9.10</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.fasterxml.jackson.datatype</groupId>
								    <artifactId>jackson-datatype-jsr310</artifactId>
								    <version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.fasterxml.jackson.core</groupId>
									<artifactId>jackson-core</artifactId>
									<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.fasterxml.jackson.core</groupId>
									<artifactId>jackson-databind</artifactId>
									<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.fasterxml.jackson.core</groupId>
									<artifactId>jackson-annotations</artifactId>
									<version>2.17.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.squareup.okhttp3</groupId>
									<artifactId>okhttp</artifactId>
									<version>4.12.0</version>
								</artifactItem>
								<!-- OkHttp SSE for streaming responses (EventSourceListener) -->
								<artifactItem>
									<groupId>com.squareup.okhttp3</groupId>
									<artifactId>okhttp-sse</artifactId>
									<version>4.12.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.squareup.okio</groupId>
									<artifactId>okio</artifactId>
									<version>3.6.0</version>
								</artifactItem>
								<artifactItem>
									<groupId>com.squareup.okio</groupId>
									<artifactId>okio-jvm</artifactId>
									<version>3.6.0</version>
								</artifactItem>
								<!-- AWS Bedrock Runtime (requires SDK 2.26.0+ for Converse API) -->
								<artifactItem>
									<groupId>software.amazon.awssdk</groupId>
									<artifactId>bedrockruntime</artifactId>
									<version>2.29.0</version>
								</artifactItem>
								<!-- Netty NIO HTTP client for AWS SDK async operations -->
								<artifactItem>
									<groupId>software.amazon.awssdk</groupId>
									<artifactId>netty-nio-client</artifactId>
									<version>2.29.0</version>
								</artifactItem>
								<!-- Netty dependencies required by netty-nio-client -->
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-codec-http</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-codec-http2</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-codec</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-transport</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-common</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-buffer</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-handler</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-transport-native-unix-common</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<artifactItem>
									<groupId>io.netty</groupId>
									<artifactId>netty-resolver</artifactId>
									<version>4.1.100.Final</version>
								</artifactItem>
								<!-- https://mvnrepository.com/artifact/dev.langchain4j/langchain4j -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j Core for @Tool annotations -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-core</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j Anthropic Provider -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-anthropic</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j Ollama Provider (local LLM) -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-ollama</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j OpenAI Provider -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-open-ai</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- LangChain4j AWS Bedrock Provider -->
								<artifactItem>
								    <groupId>dev.langchain4j</groupId>
								    <artifactId>langchain4j-bedrock</artifactId>
								    <version>0.35.0</version>
								</artifactItem>
								<!-- Retrofit2 - required by LangChain4j Anthropic -->
								<artifactItem>
								    <groupId>com.squareup.retrofit2</groupId>
								    <artifactId>retrofit</artifactId>
								    <version>2.9.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.squareup.retrofit2</groupId>
								    <artifactId>converter-jackson</artifactId>
								    <version>2.9.0</version>
								</artifactItem>
								<artifactItem>
								    <groupId>com.squareup.retrofit2</groupId>
								    <artifactId>converter-gson</artifactId>
								    <version>2.9.0</version>
								</artifactItem>
								<!-- Gson - required by Retrofit converter-gson -->
								<artifactItem>
								    <groupId>com.google.code.gson</groupId>
								    <artifactId>gson</artifactId>
								    <version>2.10.1</version>
								</artifactItem>
							</artifactItems>
							<outputDirectory>lib</outputDirectory>
							<stripVersion>true</stripVersion>
							<overWriteReleases>true</overWriteReleases>
							<overWriteSnapshots>true</overWriteSnapshots>
						</configuration>
					</execution>
				</executions>
			</plugin>
		    <!-- Maven Compiler Plugin for test sources -->
		    <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<id>compile-tests</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<source>11</source>
							<target>11</target>
							<testSource>11</testSource>
							<testTarget>11</testTarget>
						</configuration>
					</execution>
				</executions>
			</plugin>
		    <!-- Maven Surefire Plugin for JUnit 5 -->
		    <plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<version>3.2.5</version>
				<configuration>
					<includes>
						<include>**/*Test.java</include>
						<include>**/*Tests.java</include>
					</includes>
					<excludes>
						<exclude>**/TestAIProvider.java</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>