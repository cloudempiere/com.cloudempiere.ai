Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: AI
Bundle-SymbolicName: com.cloudempiere.ai
Bundle-Version: 10.0.0.qualifier
Bundle-Vendor: CLOUDEMPIERE
Automatic-Module-Name: com.cloudempiere.ai
Bundle-RequiredExecutionEnvironment: JavaSE-11
Require-Bundle: org.adempiere.base;bundle-version="10.0.0",
 org.adempiere.plugin.utils;bundle-version="10.0.0",
 org.adempiere.ui.zk;bundle-version="10.0.0",
 zul;bundle-version="0.0.0",
 zk;bundle-version="0.0.0",
 org.eclipse.osgi.services;bundle-version="3.10.200"
Bundle-Activator: com.cloudempiere.ai.Activator
Import-Package: org.adempiere.webui.factory,
 org.json,
 org.osgi.framework,
 org.osgi.service.component.annotations;version="1.3.0",
 org.slf4j,
 org.zkoss.lang;version="9.6.3",
 org.zkoss.zk.ui,
 org.zkoss.zk.ui.event,
 org.zkoss.zk.ui.util,
 org.zkoss.zul
Service-Component: OSGI-INF/*.xml
Bundle-ActivationPolicy: lazy
Export-Package: com.cloudempiere.ai.component,
 com.cloudempiere.ai.provider.factory,
 com.cloudempiere.ai.provider.dto,
 com.cloudempiere.ai.provider.langchain4j,
 com.cloudempiere.ai.model,
 com.cloudempiere.ai.service
Bundle-ClassPath: .,
